{
  "name": "caval",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:http": "VITE_HTTP=1 vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "deploy": "pnpm run build && npx wrangler deploy",
    "preview": "vite preview --host 0.0.0.0",
    "build:vectors": "node scripts/build_vector_bank.mjs",
    "export:earlybird": "uv run --python 3.12 --with torch --with transformers --with safetensors --with onnx --with onnxruntime --with onnxscript python scripts/export_earlybird_onnx.py"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "onnxruntime-web": "^1.31.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tldraw": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
