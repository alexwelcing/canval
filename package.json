{
  "name": "nifty-raman",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build:client": "bun build src/client/main.tsx --outdir public --entry-naming app.[ext] --asset-naming [name].[ext] --minify",
    "test": "bun test",
    "typecheck": "tsc -b",
    "build": "bun build --compile --minify src/index.ts --outfile app",
    "db:push": "drizzle-kit push",
    "doctor": "bun run src/tools/doctor.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tldraw": "^5.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@libsql/client": "^0.18.0",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
